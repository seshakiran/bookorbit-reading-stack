+import { ForbiddenException, BadRequestException, ConflictException, Inject, Injectable, Logger, ServiceUnavailableException } from '@nestjs/common';
+import type { ConfigType } from '@nestjs/config';
+import { execFile } from 'node:child_process';
+import { Permission, isAudioFormat, type StudioStatus } from '@bookorbit/types';
+import { appConfig } from '../../config/config';
+import type { RequestUser } from '../../common/types/request-user';
+import { BookService } from '../book/book.service';
+
+interface WorkerResult extends Partial<StudioStatus> {
+  error?: string;
+  linkedBookId?: number;
+  path?: string;
+}
+
+@Injectable()
+export class StudioService {
+  private readonly logger = new Logger(StudioService.name);
+  constructor(
+    private readonly books: BookService,
+    @Inject(appConfig.KEY) private readonly config: ConfigType<typeof appConfig>,
+  ) {}
+
+  private enabled() {
+    return Boolean(this.config.studioPython && this.config.studioWorker && this.config.studioConfig);
+  }
+
+  private call(action: string, bookId: number, user: RequestUser, body?: object): Promise<WorkerResult> {
+    if (!this.enabled()) throw new ServiceUnavailableException('The administrator must configure the audiobook studio first');
+    const started = Date.now();
+    const logAction = action === 'start' || action === 'link';
+    if (logAction) this.logger.log(`[studio.${action}] [start] bookId=${bookId} userId=${user.id} - studio operation started`);
+    return new Promise((resolve, reject) => {
+      const child = execFile(
+        this.config.studioPython,
+        [this.config.studioWorker, action, this.config.studioConfig, `${user.id}-${bookId}`],
+        { timeout: 15000, maxBuffer: 1024 * 1024 },
+        (error, stdout) => {
+          if (error) {
+            if (logAction)
+              this.logger.warn(
+                `[studio.${action}] [fail] bookId=${bookId} userId=${user.id} durationMs=${Date.now() - started} errorClass=WorkerError - studio operation failed`,
+              );
+            reject(new ServiceUnavailableException('Studio worker unavailable. Check the private server logs.'));
+            return;
+          }
+          try {
+            const result = JSON.parse(stdout) as WorkerResult;
+            if (result.error) reject(new ConflictException(result.error));
+            else {
+              if (logAction)
+                this.logger.log(
+                  `[studio.${action}] [end] bookId=${bookId} userId=${user.id} durationMs=${Date.now() - started} - studio operation accepted`,
+                );
+              resolve(result);
+            }
+          } catch {
+            reject(new ServiceUnavailableException('Invalid studio worker response'));
+          }
+        },
+      );
+      child.stdin?.end(JSON.stringify(body ?? {}));
+    });
+  }
+
+  async status(bookId: number, user: RequestUser): Promise<StudioStatus> {
+    const book = await this.books.getDetail(bookId, user);
+    const result = this.enabled() ? await this.call('status', bookId, user) : {};
+    let audioBook = book;
+    if (result.linkedBookId) audioBook = await this.books.getDetail(result.linkedBookId, user);
+    const audio = audioBook.files.find((f) => f.format && isAudioFormat(f.format));
+    return {
+      state: result.state ?? 'idle',
+      configured: result.configured ?? false,
+      narrator: result.narrator,
+      message: result.message,
+      completed_chunks: result.completed_chunks,
+      total_chunks: result.total_chunks,
+      chunks_with_asr_review_flags: result.chunks_with_asr_review_flags,
+      canCreate: user.isSuperuser || user.permissions.includes(Permission.ManageAppSettings),
+      hasEpub: book.files.some((f) => f.format === 'epub'),
+      playback: audio ? { bookId: audioBook.id, fileId: audio.id, format: audio.format! } : undefined,
+      generatedAudio: result.state === 'complete',
+    };
+  }
+
+  async start(bookId: number, user: RequestUser) {
+    if (!user.isSuperuser && !user.permissions.includes(Permission.ManageAppSettings))
+      throw new ForbiddenException('Audiobook creation requires app-settings permission');
+    const current = await this.status(bookId, user);
+    if (current.playback || current.generatedAudio) return current;
+    const book = await this.books.getDetail(bookId, user);
+    const epub = book.files.find((f) => f.format === 'epub');
+    if (!epub) throw new BadRequestException('Creation currently supports EPUB books only');
+    const file = await this.books.getFileInfo(epub.id, user);
+    await this.call('start', bookId, user, {
+      source: file.path,
+      title: book.title ?? 'Untitled',
+      author: book.authors.map((a) => a.name).join(', '),
+    });
+    return this.status(bookId, user);
+  }
+
+  async link(bookId: number, audioBookId: number, user: RequestUser) {
+    await this.books.verifyBookAccess(bookId, user);
+    const target = await this.books.getDetail(audioBookId, user);
+    if (!target.files.some((f) => f.format && isAudioFormat(f.format))) throw new BadRequestException('Choose a book containing audio');
+    await this.call('link', bookId, user, { linkedBookId: audioBookId });
+    return this.status(bookId, user);
+  }
+
+  async audio(bookId: number, user: RequestUser) {
+    await this.books.verifyBookAccess(bookId, user);
+    const result = await this.call('audio', bookId, user);
+    if (!result.path) throw new BadRequestException('Audio is not ready');
+    return result.path;
+  }
+}
