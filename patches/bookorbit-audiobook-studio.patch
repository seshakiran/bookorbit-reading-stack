+          BookBridge.
+        </p>
+        <a :href="audioUrl" download="audiobook.m4b" class="underline text-sm">Download M4B</a>
+      </template>
+      <template v-else-if="active">
+        <p role="status" class="text-sm">{{ stateLabel }} · {{ progress }}% of passages</p>
+        <progress :value="progress" max="100" class="w-full" />
+        <p class="text-sm text-muted-foreground">You can leave this page. The Mac must stay awake. Mastering and quality checks follow narration.</p>
+      </template>
+      <template v-else>
+        <p v-if="!status.configured" class="text-sm text-muted-foreground">
