+import { describe, it, expect, vi } from 'vitest';
+import { StudioService } from './studio.service';
+import { BookService } from '../book/book.service';
+import type { RequestUser } from '../../common/types/request-user';
+import type { appConfig } from '../../config/config';
+import type { ConfigType } from '@nestjs/config';
+
+const { exec } = vi.hoisted(() => ({ exec: vi.fn() }));
+vi.mock('node:child_process', () => ({ execFile: exec }));
+const user = { id: 7, isSuperuser: true, permissions: [] } as unknown as RequestUser;
+const book = { id: 9, title: 'Test', authors: [], files: [{ id: 90, format: 'epub' }] };
+function setup(enabled = true) {
+  exec.mockReset();
+  const books = {
+    getDetail: vi.fn().mockResolvedValue(book),
+    verifyBookAccess: vi.fn(),
+    getFileInfo: vi.fn().mockResolvedValue({ path: '/private/book.epub' }),
+  };
+  const config = { studioPython: enabled ? 'python' : '', studioWorker: 'worker.py', studioConfig: 'private.json' } as ConfigType<typeof appConfig>;
+  exec.mockImplementation((_python, _args, _opts, cb) => {
+    cb(null, JSON.stringify({ state: 'idle', configured: true }));
+    return { stdin: { end: vi.fn() } };
+  });
+  return { books, service: new StudioService(books as unknown as BookService, config) };
+}
+describe('Audiobook studio', () => {
+  it('rejects generation for an ordinary reader', async () => {
+    const { service } = setup();
+    await expect(service.start(9, { ...user, isSuperuser: false })).rejects.toThrow('permission');
+    expect(exec).not.toHaveBeenCalled();
+  });
+  it('finds existing audio without requiring a configured generator', async () => {
+    const { books, service } = setup(false);
+    books.getDetail.mockResolvedValue({ ...book, files: [{ id: 91, format: 'm4b' }] });
+    expect((await service.status(9, user)).playback).toEqual({ bookId: 9, fileId: 91, format: 'm4b' });
+  });
+  it('never starts generation when audio already exists', async () => {
+    const { books, service } = setup();
+    books.getDetail.mockResolvedValue({ ...book, files: [{ id: 91, format: 'm4b' }] });
+    await service.start(9, user);
+    expect(exec.mock.calls.some((c) => c[1][1] === 'start')).toBe(false);
+  });
+  it('enforces book access before invoking the worker', async () => {
+    const { books, service } = setup();
+    exec.mockClear();
+    books.getDetail.mockRejectedValue(new Error('forbidden'));
+    await expect(service.status(9, user)).rejects.toThrow('forbidden');
+    expect(exec).not.toHaveBeenCalled();
+  });
+  it('checks access to a separately linked audiobook', async () => {
+    const { books, service } = setup();
+    exec.mockImplementation((_p, _a, _o, cb) => {
+      cb(null, JSON.stringify({ linkedBookId: 12 }));
+      return { stdin: { end: vi.fn() } };
+    });
+    books.getDetail.mockResolvedValueOnce(book).mockRejectedValueOnce(new Error('forbidden'));
+    await expect(service.status(9, user)).rejects.toThrow('forbidden');
+    expect(books.getDetail).toHaveBeenLastCalledWith(12, user);
+  });
+  it('rejects linking an ebook-only entry', async () => {
+    const { service } = setup();
+    await expect(service.link(9, 10, user)).rejects.toThrow('containing audio');
+  });
+  it('rejects PDF-only creation', async () => {
+    const { books, service } = setup();
+    books.getDetail.mockResolvedValue({ ...book, files: [{ id: 90, format: 'pdf' }] });
+    await expect(service.start(9, user)).rejects.toThrow('EPUB');
+  });
+});
