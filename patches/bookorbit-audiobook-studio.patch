+import { Body, Controller, Get, Headers, Param, ParseIntPipe, Post, Res } from '@nestjs/common';
+import { createReadStream } from 'node:fs';
+import { stat } from 'node:fs/promises';
+import type { FastifyReply } from 'fastify';
+import { Permission } from '@bookorbit/types';
+import { CurrentUser } from '../../common/decorators/current-user.decorator';
+import { RequirePermission } from '../../common/decorators/require-permission.decorator';
+import type { RequestUser } from '../../common/types/request-user';
+import { LinkStudioAudioDto } from './dto/link-studio-audio.dto';
+import { StudioService } from './studio.service';
+
+@Controller('audiobook-studio')
+export class StudioController {
+  constructor(private readonly service: StudioService) {}
+  @Get(':bookId')
+  status(@Param('bookId', ParseIntPipe) id: number, @CurrentUser() user: RequestUser) {
+    return this.service.status(id, user);
+  }
+  @Post(':bookId')
+  @RequirePermission(Permission.ManageAppSettings)
+  start(@Param('bookId', ParseIntPipe) id: number, @CurrentUser() user: RequestUser) {
+    return this.service.start(id, user);
+  }
+  @Post(':bookId/link')
+  link(@Param('bookId', ParseIntPipe) id: number, @Body() dto: LinkStudioAudioDto, @CurrentUser() user: RequestUser) {
+    return this.service.link(id, dto.bookId, user);
+  }
+  @Get(':bookId/audio')
+  async audio(
+    @Param('bookId', ParseIntPipe) id: number,
+    @CurrentUser() user: RequestUser,
+    @Headers('range') range: string | undefined,
+    @Res() reply: FastifyReply,
+  ) {
+    const path = await this.service.audio(id, user);
+    const { size } = await stat(path);
+    reply.type('audio/mp4').header('Accept-Ranges', 'bytes').header('Cache-Control', 'private, no-store');
+    if (range) {
+      const match = /^bytes=(\d+)-(\d*)$/.exec(range);
+      const start = match ? Number(match[1]) : NaN;
+      const end = match?.[2] ? Number(match[2]) : size - 1;
+      if (!Number.isSafeInteger(start) || !Number.isSafeInteger(end) || start < 0 || start >= size || end < start || end >= size) {
+        return reply.status(416).header('Content-Range', `bytes */${size}`).send();
+      }
+      return reply
+        .status(206)
+        .header('Content-Range', `bytes ${start}-${end}/${size}`)
+        .header('Content-Length', end - start + 1)
+        .send(createReadStream(path, { start, end }));
+    }
+    return reply.header('Content-Length', size).send(createReadStream(path));
+  }
+}
