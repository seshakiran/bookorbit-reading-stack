+<script setup lang="ts">
+import { computed, toRef } from 'vue'
+import { useAudiobookStudio } from '../../composables/useAudiobookStudio'
+const props = defineProps<{ bookId: number }>()
+const { status, error, busy, linkId, refresh, create, link, listen } = useAudiobookStudio(toRef(props, 'bookId'))
+const active = computed(() => status.value && !['idle', 'complete', 'failed', 'interrupted'].includes(status.value.state))
+const progress = computed(() =>
+  status.value?.total_chunks ? Math.round((100 * (status.value.completed_chunks ?? 0)) / status.value.total_chunks) : 0,
+)
+const audioUrl = computed(() => `/api/v1/audiobook-studio/${props.bookId}/audio`)
+const stateLabel = computed(() => status.value?.state.replaceAll('_', ' '))
+</script>
+<template>
+  <section class="m-4 rounded-xl border bg-card p-4 space-y-3" aria-label="Audiobook studio">
+    <div class="flex flex-wrap items-center justify-between gap-3">
+      <div>
+        <h2 class="font-semibold">Listen or create an audiobook</h2>
+        <p class="text-sm text-muted-foreground">Keep your ebook and listen to its audio edition.</p>
+      </div>
+      <button class="rounded border px-3 py-2 text-sm hover:bg-muted" :disabled="busy" @click="refresh">Refresh</button>
+    </div>
+    <p v-if="error" role="alert" class="text-sm text-destructive">{{ error }}</p>
+    <template v-if="status">
