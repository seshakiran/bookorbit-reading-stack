@@ -0,0 +1,81 @@
+import { ref, watch, onUnmounted, type Ref } from 'vue'
+import { useRouter } from 'vue-router'
+import type { StudioStatus } from '@bookorbit/types'
+import { api } from '@/lib/api'
+
+export function useAudiobookStudio(bookId: Ref<number>) {
+  const status = ref<StudioStatus | null>(null)
+  const error = ref('')
+  const busy = ref(false)
+  const linkId = ref('')
+  const router = useRouter()
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let generation = 0
+  let disposed = false
+  async function request(method = 'GET', suffix = '', body?: object) {
+    const id = bookId.value
+    const version = ++generation
+    if (timer) clearTimeout(timer)
+    try {
+      const response = await api(`/api/v1/audiobook-studio/${id}${suffix}`, {
+        method,
+        ...(body ? { body: JSON.stringify(body), headers: { 'Content-Type': 'application/json' } } : {}),
+      })
+      if (!response.ok) {
+        const data = await response.json()
+        throw new Error(data.message || 'Audiobook studio request failed')
+      }
+      const next = (await response.json()) as StudioStatus
+      if (disposed || version !== generation) return
+      status.value = next
+      error.value = ''
+      if (!['idle', 'complete', 'failed', 'interrupted'].includes(next.state)) timer = setTimeout(refresh, 5000)
+    } catch (e) {
+      if (!disposed && version === generation) error.value = e instanceof Error ? e.message : 'Connection failed'
+    }
+  }
+  async function refresh() {
+    await request()
+  }
+  async function create() {
+    busy.value = true
+    try {
+      await request('POST')
+    } finally {
+      busy.value = false
+    }
+  }
+  async function link() {
+    const id = Number(linkId.value)
+    if (!Number.isSafeInteger(id) || id < 1) {
+      error.value = 'Enter the audio edition book ID from its BookOrbit URL.'
+      return
+    }
+    busy.value = true
+    try {
+      await request('POST', '/link', { bookId: id })
+    } finally {
+      busy.value = false
+    }
+  }
+  async function listen() {
+    const audio = status.value?.playback
+    if (audio) await router.push({ name: 'reader', params: { bookId: audio.bookId, fileId: audio.fileId }, query: { format: audio.format } })
+  }
+  watch(
+    bookId,
+    () => {
+      status.value = null
+      error.value = ''
+      linkId.value = ''
+      void refresh()
+    },
+    { immediate: true },
+  )
+  onUnmounted(() => {
+    disposed = true
+    generation++
+    if (timer) clearTimeout(timer)
+  })
+  return { status, error, busy, linkId, refresh, create, link, listen }
+}
