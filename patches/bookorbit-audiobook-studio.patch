+          </button>
+        </template>
+        <p v-else class="text-sm text-muted-foreground">Ask an administrator to create this audiobook.</p>
+      </template>
+      <p v-if="status.message" class="text-sm text-muted-foreground">{{ status.message }}</p>
+      <p v-if="status.chunks_with_asr_review_flags" class="text-sm text-muted-foreground">
