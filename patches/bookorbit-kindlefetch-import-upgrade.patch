+-- A BookOrbit search imports before opening. Reuse and link the bytes already fetched.
+function BookOrbitCatalog:acceptKindleFetchImport(job)
+    if type(job) ~= "table" or not tonumber(job.book_id) then return end
+    self:runConnected(function()
+        local detail, err = self:fetch(_("Opening imported BookOrbit book..."), function()
+            return self.client:catalogBook(job.book_id)
+        end)
+        if not detail then
+            self:showRetry(err, function() self:acceptKindleFetchImport(job) end)
+            return
+        end
+        self:cacheBookDetail(detail)
+        if not job.path or lfs.attributes(job.path, "mode") ~= "file" then
+            if not self.catalog_closed then self:showBookDetail(detail) end
+            return
+        end
+        local files = {}
+        for _, file in ipairs(self:supportedFiles(detail)) do
+            if string.lower(file.format or "") == string.lower(job.file_type or "") then
+                files[#files + 1] = file
+            end
+        end
+        if #files ~= 1 then
+            UIManager:show(InfoMessage:new{
+                text = _("Imported into BookOrbit, but the uploaded file could not be identified. The local copy is retained."),
+            })
+            return
+        end
+        local ok, digest = pcall(util.partialMD5, job.path)
+        if not ok or not digest then
+            UIManager:show(InfoMessage:new{ text = _("Imported into BookOrbit, but the local reading copy could not be linked.") })
+            return
+        end
+        -- The upload returned this book ID and its authenticated detail identifies the file.
+        -- Persist the association so later Open/Continue taps reuse this same local copy.
+        BookOrbitStateManager.linkFile(digest, files[1].id, detail.id, job.path)
+        self:refreshOnDevice()
+        self.on_device[detail.id] = job.path
+        self.on_device_files = self.on_device_files or {}
+        self.on_device_files[files[1].id] = job.path
+        if self.markStackDirty then self:markStackDirty() end
+        if not self.catalog_closed then self:openDownloadedFile(job.path) end
+    end)
 end
 
