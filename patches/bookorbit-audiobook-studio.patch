+import { describe, it, expect, vi, afterEach } from 'vitest'
+import { defineComponent, ref } from 'vue'
+import { mount, flushPromises } from '@vue/test-utils'
+import { useAudiobookStudio } from '../useAudiobookStudio'
+const { api, push } = vi.hoisted(() => ({ api: vi.fn(), push: vi.fn() }))
+vi.mock('@/lib/api', () => ({ api }))
+vi.mock('vue-router', () => ({ useRouter: () => ({ push }) }))
+afterEach(() => {
+  vi.clearAllMocks()
+})
+describe('audiobook studio actions', () => {
+  it('opens the existing audio edition instead of the source EPUB', async () => {
+    api.mockResolvedValue({ ok: true, json: async () => ({ state: 'idle', playback: { bookId: 106, fileId: 77, format: 'm4b' } }) })
+    const wrapper = mount(
+      defineComponent({
+        setup() {
+          return useAudiobookStudio(ref(8))
+        },
+        template: '<button @click="listen">Listen</button>',
+      }),
+    )
+    await flushPromises()
+    await wrapper.get('button').trigger('click')
+    await flushPromises()
+    expect(push).toHaveBeenCalledWith({ name: 'reader', params: { bookId: 106, fileId: 77 }, query: { format: 'm4b' } })
+    wrapper.unmount()
+  })
+  it('surfaces a busy response instead of reporting creation success', async () => {
+    api
+      .mockResolvedValueOnce({ ok: true, json: async () => ({ state: 'idle' }) })
+      .mockResolvedValueOnce({ ok: false, json: async () => ({ message: 'Studio busy' }) })
+    const wrapper = mount(
+      defineComponent({
+        setup() {
+          return useAudiobookStudio(ref(8))
+        },
+        template: '<button @click="create">Create</button><p>{{error}}</p>',
+      }),
+    )
+    await flushPromises()
+    await wrapper.get('button').trigger('click')
+    await flushPromises()
+    expect(wrapper.text()).toContain('Studio busy')
+    wrapper.unmount()
+  })
+})
